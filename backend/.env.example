# ── Yoke Agent — Environment Variables ──────────────────────
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env

# OpenAI (used for default LLM + embeddings)
OPENAI_API_KEY=sk-...

# Optional providers (also configurable via Settings > Providers in the UI)
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=
# COHERE_API_KEY=

# Database (default: SQLite in current dir)
# DATABASE_URL=sqlite:///./rag_pipeline.db

# Tracing (disabled by default — set to true to capture traces)
# TRACING_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Default admin account (created on first startup if no users exist)
# Remove or change these after the first login!
DEFAULT_ADMIN_EMAIL=admin@yokeagent.com
DEFAULT_ADMIN_PASSWORD=yokeagent2025

# Auth (auto-generated per process if not set — set a stable value for production)
# JWT_SECRET=
